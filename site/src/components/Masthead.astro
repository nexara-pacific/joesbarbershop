---
import { Image } from 'astro:assets';
import logo from '../assets/photos/01-logo.jpg';

const navLinks = [
  { href: '/about', text: 'About' },
  { href: '/2026-east-county-barbershop-cost-guide', text: 'Cost Guide' },
  { href: '/east-county-traditional-barbershop', text: 'East County' },
  { href: '/reviews', text: 'Reviews' },
  { href: '/faq', text: 'FAQ' },
];
---
<header class="masthead">
  <div class="wrap">
    <a class="brand-lockup" href="/">
      <Image src={logo} width={76} height={76} class="brand-logo" alt="Joe's Barbershop logo — round Western-Victorian wordmark with twin barber poles" />
      <div class="brand-text">
        <div class="name">Joe's Barbershop</div>
        <div class="tag">Bostonia · El Cajon · Estd. 2020</div>
      </div>
    </a>

    {/* Desktop nav: visible at >980px, hidden at mobile */}
    <nav class="primary primary-desktop" aria-label="Primary">
      {navLinks.map((l) => <a href={l.href}>{l.text}</a>)}
    </nav>

    {/* Mobile drawer: hamburger toggle, hidden at desktop. <details> is closed by default,
        which is why the nav inside it MUST be the mobile copy — browsers hide non-summary
        children of closed <details> via native disclosure logic that CSS can't override. */}
    <details class="mobile-menu">
      <summary class="menu-toggle" aria-label="Toggle menu">
        <span class="hamburger" aria-hidden="true"></span>
      </summary>
      <nav class="primary primary-mobile" aria-label="Primary mobile">
        {navLinks.map((l) => <a href={l.href}>{l.text}</a>)}
      </nav>
    </details>

    <a href="https://joe-104613.square.site/" target="_blank" rel="noopener" class="btn">Book a chair</a>
  </div>
</header>
<style>
  .masthead { border-bottom: 1px solid var(--border); background: var(--bg); position: relative; z-index: 5; }
  .masthead .wrap { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 28px; padding-block: 18px; }
  .brand-lockup { display: flex; align-items: center; gap: 16px; text-decoration: none; color: inherit; }
  .brand-lockup img { width: 76px; height: 76px; border-radius: 999px; object-fit: cover; }
  .brand-text { line-height: 1.05; }
  .brand-text .name { font-family: var(--font-display); font-size: 24px; font-weight: 700; }
  .brand-text .tag { font-family: var(--font-board); text-transform: uppercase; letter-spacing: 0.22em; font-size: 10.5px; color: var(--muted); margin-top: 4px; }

  /* Desktop: primary-desktop nav participates in grid; mobile-menu drawer is hidden. */
  nav.primary { display: flex; justify-content: center; gap: 28px; font-family: var(--font-board); text-transform: uppercase; letter-spacing: 0.16em; font-size: 12.5px; font-weight: 500; }
  nav.primary a { color: var(--fg); text-decoration: none; padding-block: 8px; border-bottom: 2px solid transparent; transition: border-color .15s ease; }
  nav.primary a:hover { border-bottom-color: var(--accent); }
  .mobile-menu { display: none; }

  @media (max-width: 980px) {
    .masthead .wrap { grid-template-columns: 1fr auto auto; gap: 12px; }
    .brand-text .tag { display: none; }
    .brand-lockup img { width: 48px; height: 48px; }
    .brand-text .name { font-size: 18px; }

    /* Hide desktop nav, show mobile drawer toggle.
       `nav.primary-desktop` matches the base rule's specificity (0,0,2,1) so the
       hide overrides it; bare `.primary-desktop` would lose to `nav.primary`. */
    nav.primary-desktop { display: none; }
    .mobile-menu { display: block; }

    .menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      cursor: pointer;
      list-style: none;
      background: transparent;
      border: 1px solid var(--border);
    }
    .menu-toggle::-webkit-details-marker { display: none; }
    .menu-toggle::marker { content: ""; }

    .hamburger {
      position: relative;
      display: block;
      width: 18px;
      height: 12px;
    }
    .hamburger::before,
    .hamburger::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      height: 2px;
      background-color: var(--fg);
    }
    .hamburger::before { top: 0; }
    .hamburger::after { bottom: 0; }
    /* Middle bar drawn on the .hamburger element itself */
    .hamburger {
      background-image: linear-gradient(var(--fg), var(--fg));
      background-position: 0 50%;
      background-size: 100% 2px;
      background-repeat: no-repeat;
    }
    .mobile-menu[open] .hamburger {
      background-image: none;
    }
    .mobile-menu[open] .hamburger::before {
      top: 50%;
      transform: translateY(-1px) rotate(45deg);
    }
    .mobile-menu[open] .hamburger::after {
      bottom: 50%;
      transform: translateY(1px) rotate(-45deg);
    }

    /* Drawer: nav drops absolute below the masthead, full-width.
       Browsers hide non-summary content of a closed <details> natively, so the
       drawer is invisible by default; this rule paints it when [open] flips. */
    .primary-mobile {
      display: flex;
      flex-direction: column;
      gap: 0;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--bg);
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
      padding: 4px var(--gutter) 12px;
      z-index: 20;
      justify-content: flex-start;
    }
    .primary-mobile a {
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
      letter-spacing: 0.16em;
      font-size: 14px;
    }
    .primary-mobile a:last-child {
      border-bottom: none;
    }

    /* Tighten the book-a-chair button at narrow viewports */
    .masthead .btn { padding: 10px 14px; font-size: 11.5px; letter-spacing: 0.14em; }
  }

  @media (max-width: 420px) {
    .masthead .wrap { gap: 8px; }
    .brand-lockup { gap: 10px; }
    .brand-text .name { font-size: 16px; }
    .masthead .btn { padding: 9px 12px; font-size: 11px; }
  }
</style>
