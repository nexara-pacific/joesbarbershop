---
import Base from '../layouts/Base.astro';
import Service from '../components/schema/Service.astro';
import FAQPage from '../components/schema/FAQPage.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { business } from '../data/business';

import midCut from '../assets/photos/05-mid-cut.jpg';
import interiorHero from '../assets/photos/03-interior-hero.jpg';
import priceBoard from '../assets/photos/06-price-board-cash-only.jpg';
import heritageChair from '../assets/photos/04-heritage-chair.jpg';

import type { ImageMetadata } from 'astro';

const heroPhotoMap: Record<string, ImageMetadata> = {
  '05-mid-cut.jpg': midCut,
  '03-interior-hero.jpg': interiorHero,
  '06-price-board-cash-only.jpg': priceBoard,
  '04-heritage-chair.jpg': heritageChair,
};

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { service: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lastUpdated = 'May 2026';

const heroPhoto = entry.data.heroPhoto && heroPhotoMap[entry.data.heroPhoto]
  ? heroPhotoMap[entry.data.heroPhoto]
  : interiorHero;

// Related services — natural pairings per CONTEXT D-08 (Claude's Discretion in CONTEXT.md).
const relatedServicesMap: Record<string, Array<{ name: string; slug: string }>> = {
  'fades':           [{ name: 'Classic Cut',      slug: 'classic-cut' },     { name: 'Line-Up',         slug: 'line-up' }],
  'classic-cut':     [{ name: 'Fades',            slug: 'fades' },           { name: 'Beard Trim',      slug: 'beard-trim' }],
  'kids-cuts':       [{ name: 'Classic Cut',      slug: 'classic-cut' },     { name: 'Fades',           slug: 'fades' }],
  'beard-trim':      [{ name: 'Hot-Towel Shave',  slug: 'hot-towel-shave' }, { name: 'Line-Up',         slug: 'line-up' }],
  'line-up':         [{ name: 'Beard Trim',       slug: 'beard-trim' },      { name: 'Fades',           slug: 'fades' }],
  'hot-towel-shave': [{ name: 'Beard Trim',       slug: 'beard-trim' },      { name: 'Classic Cut',     slug: 'classic-cut' }],
};
const relatedServices = relatedServicesMap[entry.id] ?? [];

const neighborhoods = [
  { name: 'Bostonia',  slug: 'bostonia-barber'  },
  { name: 'El Cajon',  slug: 'el-cajon-barber'  },
  { name: 'Santee',    slug: 'santee-barber'    },
  { name: 'Lakeside',  slug: 'lakeside-barber'  },
  { name: 'La Mesa',   slug: 'la-mesa-barber'   },
];
---

<Base
  title={`${entry.data.title} · Joe's Barbershop`}
  description={entry.data.bluf}
  variant="article"
>
  <Fragment slot="head">
    <Service entry={entry} pageUrl={Astro.url.href} />
    <FAQPage faqs={entry.data.faqs} pageUrl={Astro.url.href} />
  </Fragment>
  <header class="article-head">
    <div class="wrap">
      <span class="eyebrow kicker-rule">East County · {entry.data.title.toLowerCase()}</span>
      <h1>{entry.data.title} at Joe's Barbershop.</h1>
      <p class="date-stamp">UPDATED {lastUpdated.toUpperCase()}</p>
    </div>
  </header>

  <section class="bluf" aria-label="Answer capsule">
    <div class="wrap">
      <p class="bluf-lead">
        <strong>{entry.data.bluf}</strong>
      </p>
    </div>
  </section>

  <section class="service-hero">
    <div class="wrap">
      <Image src={heroPhoto} alt={`${entry.data.title} at Joe's Barbershop`} loading="eager" fetchpriority="high" decoding="sync" />
    </div>
  </section>

  <section class="price-callout" aria-label="Service price">
    <div class="wrap">
      <div class="price-callout-card">
        <span class="eyebrow">Posted price · cash only</span>
        <p class="price-amount">${entry.data.price}</p>
        <p class="price-meta">{entry.data.duration} · ATM on site</p>
        <p class="price-booking">Booking online is the best way to hold a chair. Walk-ins are accepted when the schedule has room.</p>
        <a class="price-btn" href="https://joe-104613.square.site/" target="_blank" rel="noopener">Book {entry.data.title.toLowerCase()}</a>
      </div>
    </div>
  </section>

  <section class="prose">
    <div class="wrap">
      <Content />
    </div>
  </section>

  <aside class="see-also">
    <div class="wrap">
      <h2>See also</h2>
      <ul>
        {relatedServices.map(({ name, slug }) => (
          <li><a href={`/${slug}`}>{name}</a></li>
        ))}
        <li><a href="/2026-east-county-barbershop-cost-guide">2026 East County cost guide</a></li>
      </ul>
    </div>
  </aside>

  <section class="area-served">
    <div class="wrap">
      <div class="section-head">
        <span class="section-mark" aria-hidden="true"></span>
        <div class="section-head-text">
          <span class="eyebrow">Where Joe serves</span>
          <h2>East County neighborhoods.</h2>
        </div>
      </div>
      <p class="area-intro">Joe serves East County families across five neighborhoods.</p>
      <ul>
        {neighborhoods.map(({ name, slug }) => (
          <li><a href={`/${slug}`}>{name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="faq" aria-label="Frequently asked questions">
    <div class="wrap">
      <div class="section-head">
        <span class="section-mark" aria-hidden="true"></span>
        <div class="section-head-text">
          <span class="eyebrow">{entry.data.title.toLowerCase()} · what people ask</span>
          <h2>Frequently asked questions.</h2>
        </div>
      </div>
      <div class="faq-list">
        {entry.data.faqs.map((faq, i) => (
          <article class="faq-q">
            <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ClosingCTA />
</Base>

<style>
  /* Article-page typography — copied verbatim from east-county-traditional-barbershop.astro */
  .article-head {
    padding: clamp(56px, 7vw, 96px) 0 clamp(32px, 4vw, 48px);
    background: var(--bg);
  }
  .article-head .wrap {
    max-width: 820px;
  }
  .article-head h1 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.008em;
    margin: 0 0 18px;
  }
  .article-head .date-stamp {
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    margin: 0;
  }

  .bluf {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .bluf .bluf-lead {
    font-size: 18px;
    line-height: 1.6;
    max-width: 66ch;
    margin: 0;
  }
  @media (max-width: 600px) {
    .bluf .bluf-lead {
      font-size: 17px;
    }
  }

  /* Service hero — bespoke per CONTEXT D-05 (lazy-load, simple <Image>, NOT the OD-5 <Hero> component).
     Column width comes from utilities.css article-page allowlist. */
  .service-hero {
    background: var(--bg);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .service-hero img {
    width: 100%;
    height: auto;
    max-width: 980px;
    display: block;
    margin: 0 auto;
  }

  /* Price callout — bespoke per CONTEXT D-06. Echoes PriceBoard heritage (board font, board-bg, large $ callout)
     without importing the homepage-only PriceBoard component (Phase 3 D-17).
     Column width comes from utilities.css article-page allowlist. */
  .price-callout {
    background: var(--board-bg);
    color: var(--board-fg);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .price-callout-card {
    text-align: center;
    padding: 28px 24px;
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .price-callout-card .eyebrow {
    color: var(--board-fg);
    opacity: 0.85;
  }
  .price-callout-card .price-amount {
    font-family: var(--font-board);
    font-size: clamp(56px, 7vw, 96px);
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1;
    margin: 12px 0;
    color: var(--board-fg);
  }
  .price-callout-card .price-meta {
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 600;
    color: var(--board-fg);
    opacity: 0.8;
    margin: 0;
  }
  .price-callout-card .price-booking {
    font-size: 16px;
    line-height: 1.5;
    max-width: 46ch;
    margin: 20px auto 18px;
    color: var(--board-fg);
    opacity: 0.9;
  }
  .price-callout-card .price-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    background: var(--board-fg);
    color: var(--board-bg);
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--board-fg);
  }
  .price-callout-card .price-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--fg);
  }

  .prose {
    background: var(--bg);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.006em;
    margin: 0 0 28px;
  }
  .prose p {
    font-size: 17.5px;
    line-height: 1.65;
    max-width: 70ch;
    margin: 0 0 24px;
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .prose a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    color: var(--accent);
  }

  /* See also — bespoke; mirrors .area-served visual treatment (board font, uppercase, letter-spacing). */
  .see-also {
    background: var(--surface);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .see-also h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.5vw, 32px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .see-also ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
  }
  .see-also li a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }
  .see-also li a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .see-also ul {
      flex-direction: column;
      gap: 8px;
    }
  }

  .area-served {
    background: var(--bg);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .area-served .area-intro {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 24px;
    color: var(--fg);
  }
  .area-served ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
  }
  .area-served li a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }
  .area-served li a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .area-served ul {
      flex-direction: column;
      gap: 8px;
    }
  }

  .faq {
    background: var(--surface);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 980px;
    margin-top: 40px;
  }
  .faq-q {
    padding-top: 22px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 32px;
  }
  .faq-q .num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .faq-q h3 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0 0 12px;
  }
  .faq-q p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--fg);
    max-width: 70ch;
  }
</style>
