---
import Base from '../layouts/Base.astro';
import Article from '../components/schema/Article.astro';
import FAQPage from '../components/schema/FAQPage.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import LastUpdated from '../components/LastUpdated.astro';
import { business } from '../data/business';
import mtimes from '../data/git-mtimes.json';

const lastUpdated = 'May 2026';

const dateModified = mtimes['site/src/pages/east-county-traditional-barbershop.astro'];
const datePublished = '2026-05-08';

// Parallel array mirroring the 6 DOM FAQs below.
// TODO Phase 7: consolidate DOM ↔ schema array duplication.
const faqs = [
  {
    q: "What makes Joe's Barbershop a traditional barbershop?",
    a: "The traditional model has three non-negotiables: the barber knows the craft, the price is fixed and visible before you sit, and the shop is open without an appointment. Joe's Barbershop delivers all three. Joe Denesowicz opened the shop in 2020 in a Bostonia strip mall — checkerboard floors, mahogany chairs, a letter board that shows the price. No upsell scripts. No add-on pressure. The opposite of the chain experience, where you might see a different stylist every visit and get a pitch for a $15 scalp treatment before you leave.",
  },
  {
    q: "Where is Joe's Barbershop in East County?",
    a: `Joe's Barbershop is at ${business.address.street}, ${business.address.suite}, ${business.address.city}, ${business.address.state} ${business.address.zip} — a Bostonia strip mall near the 8 freeway. The location is central to all five East County neighborhoods the shop serves: Bostonia, El Cajon, Santee, Lakeside, and La Mesa. Phone: ${business.phone}. Open Tue–Sat.`,
  },
  {
    q: "Do I need an appointment at Joe's Barbershop?",
    a: "No appointment needed — and that is not a convenience feature at Joe's, it is the traditional barbershop model. Walk-in availability is part of what separates a neighborhood shop from a booking-app grooming lounge. Joe's is open Tue–Sat and takes walk-ins every day. If you want a reserved slot, the Square booking link is available. But most customers walk straight in.",
  },
  {
    q: "What does a haircut cost at Joe's Barbershop?",
    a: `Transparent pricing is a traditional-shop value, not a feature. The price is on the board before you sit. A standard haircut is $${business.prices.haircut}. A shave is $${business.prices.shave}. A beard line-up is $${business.prices.beardLineUp}. A haircut-plus-beard combo is $${business.prices.haircutBeard}. Clean-ups are $${business.prices.cleanUp}. All cash — no card processing fee layered into the price. ATM on site.`,
  },
  {
    q: "Does Joe's Barbershop serve neighborhoods across East County?",
    a: "Joe's Barbershop serves five East County neighborhoods: Bostonia, El Cajon, Santee, Lakeside, and La Mesa. The Bostonia strip-mall location on E Bradley Ave sits close to the 8 freeway, making it a short drive from all five. Customers from across East County choose Joe's over closer chains for the same reason: consistent craft at a fixed price, no booking required.",
  },
  {
    q: "Does Joe's Barbershop do kids' haircuts?",
    a: "Kids' haircuts are part of the regular service at Joe's. Families walk in together — kids sit alongside parents, no separate kids-only setup, no awkward handoff. A traditional neighborhood shop serves the whole family. That is how it has always worked, and that is how it works at Joe's. Same walk-in standard, same craft, same clean cut.",
  },
];

const neighborhoods = [
  { name: 'Bostonia',  slug: 'bostonia-barber'  },
  { name: 'El Cajon',  slug: 'el-cajon-barber'  },
  { name: 'Santee',    slug: 'santee-barber'    },
  { name: 'Lakeside',  slug: 'lakeside-barber'  },
  { name: 'La Mesa',   slug: 'la-mesa-barber'   },
];
---

<Base
  title="Traditional barbershop · East County · Joe's Barbershop"
  description="Joe's Barbershop is the traditional barbershop in Bostonia, East County San Diego. Walk-ins welcome, cash only, $30 cuts. Tue–Sat."
  variant="article"
  ogType="article"
>
  <Fragment slot="head">
    <Article
      headline="What 'traditional barbershop' means in East County."
      description="What traditional barbershop means in East County: fixed price on the board, same barber every visit, no upsell, no booking app required. Joe's in Bostonia."
      url={Astro.url.href}
      datePublished={datePublished}
      dateModified={dateModified}
      authorName="Joe Denesowicz"
    />
    <FAQPage faqs={faqs} pageUrl={Astro.url.href} />
  </Fragment>
  <header class="article-head">
    <div class="wrap">
      <span class="eyebrow kicker-rule">East County · traditional barbering</span>
      <h1>What &ldquo;traditional barbershop&rdquo; means in East County.</h1>
      <p class="date-stamp">UPDATED {lastUpdated.toUpperCase()}</p>
    </div>
  </header>

  <section class="bluf" aria-label="Answer capsule">
    <div class="wrap">
      <p class="bluf-lead">
        <strong>A traditional barbershop in East County is one with a fixed price on the board before you sit down, the same barber every visit, no upsell scripts, and no booking app required. Joe&rsquo;s Barbershop in Bostonia is one of the few East County shops still cutting that way.</strong>
        Joe Denesowicz opened the shop in 2020 and built a {business.ratings.google.value}-star reputation across {business.ratings.google.count} Google and {business.ratings.yelp.count} Yelp reviews. Open Tue–Sat, $30 base. Walk in any day.
      </p>
    </div>
  </section>

  <div class="wrap">
    <LastUpdated isoDate={dateModified} />
  </div>

  <section class="prose">
    <div class="wrap">
      <h2>What East County traditional barbering means</h2>
      <p>Traditional barbering is a craft commitment, not a category label. At Joe's Barbershop it means the price is on the board before you sit — $30 for a haircut, visible before you walk through the door. It means the cut comes from skill built over years behind the chair, not a script from a training manual. The shop in its Bostonia strip mall has checkerboard floors and mahogany chairs because that is what the heritage looks like, not because it was styled to look that way. Chains cycle through stylists and build upsell pressure into the transaction. Joe's does not. That distinction is why customers from across East County drive past grooming lounges to get here.</p>
      <p>The working-class East County market has plenty of barbershops, but the traditional model has mostly drifted. Modern grooming lounges charge appointment-required, premium-coded rates for a cut that competes directly with Joe's $30 board price. High-volume shops have shifted toward booking apps and specialty fades. Joe's Barbershop holds the ground that local barbershops used to own everywhere: same barber, fixed price, open door. The {business.ratings.google.value}-star average across {business.ratings.google.count} Google and {business.ratings.yelp.count} Yelp reviews is the proof that the model works — not marketing copy, not a campaign. Families walk in together: kids alongside parents, no separate kids-only setup. That is what traditional actually means.</p>
    </div>
  </section>

  <section class="area-served">
    <div class="wrap">
      <div class="section-head">
        <span class="section-mark" aria-hidden="true"></span>
        <div class="section-head-text">
          <span class="eyebrow">Where Joe serves</span>
          <h2>East County neighborhoods.</h2>
        </div>
      </div>
      <p class="area-intro">Joe serves East County families across five neighborhoods.</p>
      <ul>
        {neighborhoods.map(({ name, slug }) => (
          <li><a href={`/${slug}`}>{name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="faq" aria-label="Frequently asked questions">
    <div class="wrap">
      <div class="section-head">
        <span class="section-mark" aria-hidden="true"></span>
        <div class="section-head-text">
          <span class="eyebrow">East County · what people ask</span>
          <h2>Frequently asked questions.</h2>
        </div>
      </div>
      <div class="faq-list">
        <article class="faq-q">
          <span class="num" aria-hidden="true">01</span>
          <div>
            <h3>What makes Joe's Barbershop a traditional barbershop?</h3>
            <p>The traditional model has three non-negotiables: the barber knows the craft, the price is fixed and visible before you sit, and the shop is open without an appointment. Joe's Barbershop delivers all three. Joe Denesowicz opened the shop in 2020 in a Bostonia strip mall — checkerboard floors, mahogany chairs, a letter board that shows the price. No upsell scripts. No add-on pressure. The opposite of the chain experience, where you might see a different stylist every visit and get a pitch for a $15 scalp treatment before you leave.</p>
          </div>
        </article>
        <article class="faq-q">
          <span class="num" aria-hidden="true">02</span>
          <div>
            <h3>Where is Joe's Barbershop in East County?</h3>
            <p>Joe's Barbershop is at {business.address.street}, {business.address.suite}, {business.address.city}, {business.address.state} {business.address.zip} — a Bostonia strip mall near the 8 freeway. The location is central to all five East County neighborhoods the shop serves: Bostonia, El Cajon, Santee, Lakeside, and La Mesa. Phone: {business.phone}. Open Tue–Sat.</p>
          </div>
        </article>
        <article class="faq-q">
          <span class="num" aria-hidden="true">03</span>
          <div>
            <h3>Do I need an appointment at Joe's Barbershop?</h3>
            <p>No appointment needed — and that is not a convenience feature at Joe's, it is the traditional barbershop model. Walk-in availability is part of what separates a neighborhood shop from a booking-app grooming lounge. Joe's is open Tue–Sat and takes walk-ins every day. If you want a reserved slot, the Square booking link is available. But most customers walk straight in.</p>
          </div>
        </article>
        <article class="faq-q">
          <span class="num" aria-hidden="true">04</span>
          <div>
            <h3>What does a haircut cost at Joe's Barbershop?</h3>
            <p>Transparent pricing is a traditional-shop value, not a feature. The price is on the board before you sit. A standard haircut is ${business.prices.haircut}. A shave is ${business.prices.shave}. A beard line-up is ${business.prices.beardLineUp}. A haircut-plus-beard combo is ${business.prices.haircutBeard}. Clean-ups are ${business.prices.cleanUp}. All cash — no card processing fee layered into the price. ATM on site.</p>
          </div>
        </article>
        <article class="faq-q">
          <span class="num" aria-hidden="true">05</span>
          <div>
            <h3>Does Joe's Barbershop serve neighborhoods across East County?</h3>
            <p>Joe's Barbershop serves five East County neighborhoods: Bostonia, El Cajon, Santee, Lakeside, and La Mesa. The Bostonia strip-mall location on E Bradley Ave sits close to the 8 freeway, making it a short drive from all five. Customers from across East County choose Joe's over closer chains for the same reason: consistent craft at a fixed price, no booking required.</p>
          </div>
        </article>
        <article class="faq-q">
          <span class="num" aria-hidden="true">06</span>
          <div>
            <h3>Does Joe's Barbershop do kids' haircuts?</h3>
            <p>Kids' haircuts are part of the regular service at Joe's. Families walk in together — kids sit alongside parents, no separate kids-only setup, no awkward handoff. A traditional neighborhood shop serves the whole family. That is how it has always worked, and that is how it works at Joe's. Same walk-in standard, same craft, same clean cut.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <ClosingCTA />
</Base>

<style>
  .article-head {
    padding: clamp(56px, 7vw, 96px) 0 clamp(32px, 4vw, 48px);
    background: var(--bg);
  }
  .article-head .wrap {
    max-width: 820px;
  }
  .article-head h1 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.008em;
    margin: 0 0 18px;
  }
  .article-head .date-stamp {
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--muted);
    margin: 0;
  }

  .bluf {
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    padding-block: clamp(40px, 5vw, 64px);
  }
  .bluf .bluf-lead {
    font-size: 18px;
    line-height: 1.6;
    max-width: 66ch;
    margin: 0;
  }
  @media (max-width: 600px) {
    .bluf .bluf-lead {
      font-size: 17px;
    }
  }

  .prose {
    background: var(--bg);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .prose h2 {
    font-family: var(--font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.006em;
    margin: 0 0 28px;
  }
  .prose p {
    font-size: 17.5px;
    line-height: 1.65;
    max-width: 70ch;
    margin: 0 0 24px;
  }
  .prose p:last-child {
    margin-bottom: 0;
  }
  .prose a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .prose a:hover {
    color: var(--accent);
  }

  .area-served {
    background: var(--surface);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .area-served .area-intro {
    font-size: 17px;
    line-height: 1.6;
    margin: 0 0 24px;
    color: var(--fg);
  }
  .area-served ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
  }
  .area-served li a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border);
    background: var(--bg);
    font-family: var(--font-board);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: var(--fg);
  }
  .area-served li a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  @media (max-width: 600px) {
    .area-served ul {
      flex-direction: column;
      gap: 8px;
    }
  }

  .faq {
    background: var(--bg);
    padding-block: clamp(56px, 7vw, 96px);
  }
  .faq-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 980px;
    margin-top: 40px;
  }
  .faq-q {
    padding-top: 22px;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 32px;
  }
  .faq-q .num {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .faq-q h3 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.005em;
    margin: 0 0 12px;
  }
  .faq-q p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--fg);
    max-width: 70ch;
  }
</style>
